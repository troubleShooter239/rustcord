{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Rustcord",
    "version": "0.1.0",
    "identifier": "io.github.troubleshooter239.rustcord",
    "build": {
        "frontendDist": "src/native/ui",
        "beforeBuildCommand": "node scripts/prepare-vencord.mjs",
        "beforeDevCommand": "node scripts/prepare-vencord.mjs"
    },
    "app": {
        "windows": [],
        "security": {
            "capabilities": ["discord", "quick-css"],
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
        }
    },
    "bundle": {
        "active": true,
        "icon": ["static/tray.png", "build/icon.ico", "build/icon.icns"],
        "resources": {
            ".vencord/vencordDesktopRenderer.js.LEGAL.txt": "licenses/Vencord-third-party.txt",
            "LICENSE": "licenses/GPL-3.0.txt"
        },
        "macOS": {
            "infoPlist": "build/Rustcord-Info.plist",
            "minimumSystemVersion": "14.0"
        }
    }
}
